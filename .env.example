# Gemini API Key (get one from https://aistudio.google.com/)
GEMINI_API_KEY=your_api_key_here

# Optional: Override the model (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Optional: Override printer port (default: /dev/serial0)
# DEWEY_PRINTER_PORT=/dev/serial0

# Optional: Override camera index (default: 0)
# DEWEY_CAM_INDEX=0
